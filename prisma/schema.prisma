generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  createdAt       DateTime     @default(now())

  emailVerified   Boolean      @default(false)
  image           String?
  updatedAt       DateTime     @updatedAt

  sessions        Session[]
  accounts        Account[]

  books           Book[]
  music           Music[]
  magazines       Magazine[]
  artworks        Artwork[]
  museums         Museum[]
  galleries       Gallery[]
  images          Image[]
  photographs     Photograph[]
  ideas           Idea[]
  quotes          Quote[]
  news            NewCollection[]
}

model Session {
  id              String       @id
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  token           String       @unique
  updatedAt       DateTime     @updatedAt
  ipAddress       String?
  userAgent       String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id              String       @id @default(cuid())
  identifier      String
  value           String
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Book {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  title           String
  author          String
  year            String
  pages           Int
  discovered_by   String
  note            String
  bestQuote       String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Music {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  format          String
  title           String
  author          String
  year            String
  discovered_by   String
  note            String
  bestQuote       String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Magazine {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  title           String
  issue           String
  date            String
  discovered_by   String
  note            String
  bestQuote       String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Artwork {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  format          String
  title           String
  author          String
  year            String
  technique       String
  dimensions      String
  discovered_by   String
  note            String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Museum {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
 title           String
  city            String
  exhibition      String
  date            DateTime
  discovered_by   String
  note            String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Gallery {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  name            String
  city            String
  artist          String
  exhibition      String
  date            DateTime
  note            String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Image {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  title           String
  creator         String
  year            Int
  source          String
  discovered_by   String
  note            String
  
  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Photograph {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  photographer    String
  title           String
  location        String
  source          String
  note            String
  
  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Idea {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  title           String
  category        String
  inspiration     String
  description     String
  next_step       String

  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Quote {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  quote           String
  author          String
  source          String
  year            Int
  context         String
  
  imageUrl        String?
  createdAt       DateTime @default(now())
}

model NewCollection {
  id              Int           @id @default(autoincrement())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  name            String
  description     String
  reason          String

  imageUrl        String?
  createdAt       DateTime @default(now())
}